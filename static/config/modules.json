{
  "version": 1,
  "_comment": "Manager 7998 的兼容模块目录。权威导航来自 Manager /api/modules；本文件只供旧 CLI/客户端读取，不对应业务端口网页。字段：id 唯一标识；title 标题；desc 描述；icon 网页用文本；sfSymbol 苹果原生用 SF Symbol 名；path 为 Manager 路由；requiresAuth 是否需登录；roles 为角色限制；managerOnly 表示仅由 Manager 提供。",
  "modules": [
    {
      "id": "home",
      "title": "主页",
      "desc": "选择研究模块",
      "icon": "grid",
      "sfSymbol": "square.grid.2x2",
      "path": "/",
      "requiresAuth": false,
      "sidebarVisible": true,
      "homeVisible": false,
      "pinned": true,
      "roles": []
    },
    {
      "id": "jobs",
      "title": "测试",
      "desc": "选择测试类型或查看测试任务",
      "icon": "任务",
      "sfSymbol": "list.bullet.rectangle",
      "path": "/jobs?section=types",
      "requiresAuth": false,
      "roles": []
    },
    {
      "id": "products",
      "title": "产品管理",
      "desc": "产品组管理、品种价格序列查看",
      "icon": "📈",
      "sfSymbol": "chart.line.uptrend.xyaxis",
      "path": "/products",
      "requiresAuth": false,
      "roles": []
    },
    {
      "id": "sqlite_web",
      "title": "数据库",
      "desc": "浏览统一 SQLite 数据库",
      "icon": "SQL",
      "sfSymbol": "cylinder.split.1x2",
      "path": "/sqlite-web/",
      "requiresAuth": true,
      "roles": [],
      "managerOnly": true,
      "homeOnly": true
    },
    {
      "id": "custom_factors",
      "title": "因子库",
      "desc": "浏览、创建和管理因子",
      "icon": "🧬",
      "sfSymbol": "atom",
      "path": "/factors",
      "requiresAuth": true,
      "roles": []
    },
    {
      "id": "admin_users",
      "title": "用户与机构管理",
      "desc": "管理机构、用户层级与管理员权限",
      "icon": "🏛",
      "sfSymbol": "building.columns",
      "path": "/manager?section=accounts",
      "requiresAuth": true,
      "roles": ["super_admin", "org_admin", "level_admin"]
    },
    {
      "id": "server_operations",
      "title": "服务器运行状态",
      "desc": "管理 FactorTester 服务端口并查看全服测试任务队列",
      "icon": "OPS",
      "sfSymbol": "server.rack",
      "path": "/manager?section=server",
      "requiresAuth": true,
      "roles": ["super_admin"],
      "managerOnly": true,
      "homeOnly": true
    },
    {
      "id": "docs",
      "title": "技术文档",
      "desc": "前后端架构、API 接口、因子说明",
      "icon": "📖",
      "sfSymbol": "book",
      "path": "/docs",
      "requiresAuth": false,
      "roles": [],
      "managerOnly": true,
      "homeOnly": true
    }
  ]
}
