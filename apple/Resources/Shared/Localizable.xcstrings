    "填写 PostgreSQL 服务器可达的 IP 地址或主机名" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the reachable IP address or hostname of the PostgreSQL server"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"填写 PostgreSQL 服务器可达的 IP 地址或主机名"}}}},
    "PostgreSQL 默认使用 5432" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"PostgreSQL uses port 5432 by default"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"PostgreSQL 默认使用 5432"}}}},
