    "保存前会验证网络、凭据与数据库 schema" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Network access, credentials, and the database schema are verified before saving"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前会验证网络、凭据与数据库 schema"}}}},
