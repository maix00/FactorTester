    "管理当前服务器的访客白名单与所有已认证设备" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage this server's visitor allowlist and all registered devices"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理当前服务器的访客白名单与所有已认证设备"}}}},
    "需要超级管理员" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Super administrator required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要超级管理员"}}}},
    "只有超级管理员可以管理访客白名单和已认证设备。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only a super administrator can manage the visitor allowlist and registered devices."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有超级管理员可以管理访客白名单和已认证设备。"}}}},
