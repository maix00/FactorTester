    "连接成功后立即切换本机 Manager" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Switch this Manager immediately after a successful connection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接成功后立即切换本机 Manager"}}}},
    "由服务器环境管理" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Managed by the server environment"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"由服务器环境管理"}}}},
    "已配置" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Configured"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置"}}}},
    "未配置" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not configured"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未配置"}}}},
