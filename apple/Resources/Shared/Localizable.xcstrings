    "研究报告索引不存在。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report index does not exist."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告索引不存在。"}}}},
    "研究报告索引缺少章节与检查点的稳定映射。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report index lacks a stable mapping between sections and checkpoints."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告索引缺少章节与检查点的稳定映射。"}}}},
    "该研究记录尚无完整中文报告。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This research record does not have a complete report yet."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该研究记录尚无完整中文报告。"}}}},
    "请先在“设置 → 个人工作区”中选择当前用户目录，授权 FTClient 读取中文研究报告。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the current user directory in Settings → Personal Workspace to authorize FTClient to read research reports."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在“设置 → 个人工作区”中选择当前用户目录，授权 FTClient 读取中文研究报告。"}}}},
    "研究报告超出本地安全读取上限。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report exceeds the local safe read limit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告超出本地安全读取上限。"}}}},
    "研究报告完整性校验失败。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Research report integrity verification failed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告完整性校验失败。"}}}},
    "研究报告未能从可信起点连续重建，需要从根起点重新研究。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report could not be reconstructed continuously from a trusted checkpoint; restart from the root checkpoint."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告未能从可信起点连续重建，需要从根起点重新研究。"}}}},
    "研究报告格式不受支持。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report format is not supported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告格式不受支持。"}}}},
    "研究报告没有可信的本地图片目录。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The research report has no trusted local image directory."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"研究报告没有可信的本地图片目录。"}}}},
    "报告图片尚未保存到个人工作区。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The report image has not been saved to the personal workspace."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报告图片尚未保存到个人工作区。"}}}},
    "报告图片不是受支持的有界普通文件。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The report image is not a supported bounded regular file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报告图片不是受支持的有界普通文件。"}}}},
    "报告图片完整性校验失败。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Report image integrity verification failed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报告图片完整性校验失败。"}}}},
