    "没有在线服务端口" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No service ports are online"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有在线服务端口"}}}},
