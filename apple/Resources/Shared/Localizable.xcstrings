    "撤销" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Revoke"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销"}}}},
    "设备已撤销" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Device revoked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备已撤销"}}}},
    "例如：我的 Mac" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"For example: My Mac"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"例如：我的 Mac"}}}},
    "设备名称" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Device name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备名称"}}}},
