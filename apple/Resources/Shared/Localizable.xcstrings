    "密码写入服务器权限 600 的状态文件且不会回显" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The password is stored in a mode-600 server state file and is never returned"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码写入服务器权限 600 的状态文件且不会回显"}}}},
    "SSL 模式" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"SSL mode"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SSL 模式"}}}},
