{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FTClient Unified Gateway (7998)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/manager/app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--repo", "${workspaceFolder}",
                "--host", "0.0.0.0",
                "--port", "7998"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Module: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "${relativeFileDirname}.${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
