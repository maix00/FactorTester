{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: worktree manager",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/worktree_flask_manager.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "args": ["--repo", "${workspaceFolder}", "--port", "7998"]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Module: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "${relativeFileDirname}.${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
