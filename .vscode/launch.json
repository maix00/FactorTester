{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: start_server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/start_server.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "FLASK_DEBUG": "1"
            },
            "args": ["--port", "8000"]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}