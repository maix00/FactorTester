[Unit]
Description=FactorTester main-8000 research job daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/opt/factortester/current
EnvironmentFile=-/opt/factortester/manager-state/manager.env
EnvironmentFile=-/etc/factortester/control-db.env
Environment=HOME=/home/ecs-user
Environment=PYTHONUNBUFFERED=1
Environment=GTHT_DEPLOYMENT_ID=main-8000
Environment=GTHT_JOB_ARTIFACT_ROOT=/data/job-results
ExecStart=/opt/factortester/venv/bin/python /opt/factortester/current/scripts/research_job_daemon.py --deployment-id main-8000 --socket /opt/factortester/manager-state/main-8000.sock --planner-workers 1 --execution-workers 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
