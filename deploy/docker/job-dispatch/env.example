RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=15672
FACTORTESTER_DEPLOYMENT_ID=local-docker
# Authentication/control-plane authority; not an execution-node identity.
FACTORTESTER_SERVER_ID=replace-with-manager-server-id
# Stable node identity; different independent execution nodes use different values.
TR_EXECUTION_NODE_ID=replace-with-execution-node-id
# Equal only for the same kernel, backing files and authorized shared cache.
TR_SHARED_STORAGE_ID=replace-with-kernel-storage-domain-id
# Path as seen inside the worker container.
FACTORTESTER_JOB_DB=/data/cache.db
FACTORTESTER_STATE_ROOT=/opt/factortester-container/state
FACTORTESTER_DATA_ROOT=/data
FACTORTESTER_BASE_IMAGE=factortester-public:local
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2
TR_SHARED_DATA_CACHE_BYTES=536870912
TR_SHARED_DATA_ENTRY_BYTES=67108864
TR_DATA_QUERY_CONCURRENCY=4
