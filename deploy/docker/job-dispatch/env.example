RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=15672
FACTORTESTER_DEPLOYMENT_ID=local-docker
# Must match the existing Manager identity, not a new worker identity.
FACTORTESTER_SERVER_ID=replace-with-manager-server-id
# Path as seen inside the worker container.
FACTORTESTER_JOB_DB=/data/cache.db
FACTORTESTER_STATE_ROOT=/opt/factortester-container/state
FACTORTESTER_DATA_ROOT=/data
FACTORTESTER_BASE_IMAGE=factortester-public:local
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2
TR_SHARED_DATA_CACHE_BYTES=536870912
TR_SHARED_DATA_ENTRY_BYTES=67108864
TR_DATA_QUERY_CONCURRENCY=4
