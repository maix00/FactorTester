# Copy outside the repository and restrict to mode 0600. Values below are
# examples; no private key, token, password, or database URL belongs here.
FACTORTESTER_PUBLIC_PROJECT=factortester-public
FACTORTESTER_REVISION=0000000000000000000000000000000000000000
FACTORTESTER_PUBLIC_IMAGE=factortester-public
FACTORTESTER_POSTGRES_IMAGE=factortester-postgresql-control
FACTORTESTER_UID=1000
FACTORTESTER_GID=1000

# Optional regional mirrors used only while building images. Runtime traffic
# does not use these endpoints. The HTTP bootstrap mirrors are used only to
# install the CA bundle; Debian package signatures are still verified.
FACTORTESTER_DEBIAN_BOOTSTRAP_MIRROR=http://deb.debian.org/debian
FACTORTESTER_DEBIAN_BOOTSTRAP_SECURITY_MIRROR=http://deb.debian.org/debian-security
FACTORTESTER_DEBIAN_MIRROR=https://deb.debian.org/debian
FACTORTESTER_DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
FACTORTESTER_PIP_INDEX_URL=https://pypi.org/simple

# Optional container memory ceiling.  Leave unset or 0 (no ceiling): a cap
# below a heavy research job's working set makes the kernel OOM-kill the
# worker inside the container, and the restart policy then replays the job
# into the same cap -- the deployment looks hung while it loops.
FACTORTESTER_PUBLIC_MEMORY_LIMIT=0

# Per-worker RSS ceiling for the 1 planner + 2 execution worker pool.  The
# upstream default (3 GiB/worker = 9 GiB) assumes a larger host; 1 GiB keeps
# the pool around 3 GiB.  Raise only with host memory.
GTHT_JOB_WORKER_RECYCLE_PEAK_RSS_BYTES=1073741824

# Datasets kept warm per worker and concurrent execution workers.  Both trade
# queue throughput for memory and CPU headroom that the website also needs.
GTHT_JOB_WORKER_MAX_CACHE_KEYS=16
GTHT_JOB_PLANNER_WORKERS=1
GTHT_JOB_EXECUTION_WORKERS=1

FACTORTESTER_SERVER_ID=public-main-example
FACTORTESTER_PUBLIC_ADDRESS=203.0.113.10
# Account registration and alias-only login are scoped to this Manager.
FACTORTESTER_MANAGED_ORGANIZATIONS=default
FACTORTESTER_MANAGER_PUBLIC_ENDPOINT=https://203.0.113.10:7998
FACTORTESTER_ARTIFACT_PUBLIC_ENDPOINT=https://203.0.113.10:7997
# Optional ingress origins that may show the visitor-mode entry. Do not put
# the public IP here; the entry redirects to FACTORTESTER_MANAGER_PUBLIC_ENDPOINT.
FACTORTESTER_PUBLIC_VISITOR_ORIGINS=https://visitor.example.invalid
# Optional, case-sensitive account references permitted to leave public
# visitor mode by password. Current public deployment: testA.
FACTORTESTER_PUBLIC_VISITOR_LOGIN_ALLOWLIST=testA

# Production replaces the native listeners on these ports.
FACTORTESTER_MANAGER_HOST_PORT=7998
FACTORTESTER_ARTIFACT_HOST_PORT=7997
FACTORTESTER_FEDERATION_UDP_HOST_PORT=51820
FACTORTESTER_DB_WIREGUARD_UDP_HOST_PORT=51821
# Waitress worker threads for the business app (8000).  The platform default
# drops to 2 on a small Linux host, which serialises concurrent Web/API
# requests; a public deployment should raise it (for example 8).  Values are
# clamped to 1..64.
FACTORTESTER_WAITRESS_THREADS=8

# The FactorTester identity preserves the federation subnet; PostgreSQL owns a
# separate subnet and key.
# These are the two identities' own interface addresses. Remote peers are a
# deployment-managed set of WireGuard [Peer] records, not one environment value.
FACTORTESTER_FEDERATION_LOCAL_ADDRESS=10.77.0.1
FACTORTESTER_DATABASE_LOCAL_ADDRESS=10.79.0.1
FACTORTESTER_DB_ALLOWED_WIREGUARD_CIDRS=10.79.0.2/32
FACTORTESTER_REQUIRE_PEER_LISTENERS=1

FACTORTESTER_DATA_ROOT=/data
FACTORTESTER_STATE_ROOT=/opt/factortester-container/state
FACTORTESTER_SETTINGS_FILE=/opt/factortester/releases/.settings
FACTORTESTER_FEDERATION_WIREGUARD_DIR=/opt/factortester-container/secrets/federation-wireguard
FACTORTESTER_DB_WIREGUARD_DIR=/opt/factortester-container/secrets/database-wireguard
FACTORTESTER_MANAGER_TLS_DIR=/opt/factortester/manager-state/tls
FACTORTESTER_MANAGER_STATE_SECRETS_DIR=/opt/factortester-container/secrets/manager-state
# Optional owner-only Mihomo YAML: place mihomo.yaml in the directory above.
# The super-admin module starts/stops it; no 7890/9090 host ports are opened.
FACTORTESTER_POSTGRES_TLS_DIR=/opt/factortester-container/secrets/postgres-tls
FACTORTESTER_FEDERATION_CA_SOURCE=/opt/factortester/manager-state/tls/manager.crt
FACTORTESTER_CONTROL_DB_ENV_FILE=/opt/factortester-container/secrets/control-db.env
FACTORTESTER_CONTROL_DB_PASSWORD_FILE=/opt/factortester-container/secrets/control-db-password
FACTORTESTER_POSTGRES_SUPERUSER_PASSWORD_FILE=/opt/factortester-container/secrets/postgres-superuser-password
FACTORTESTER_POSTGRES_MIGRATION_DIR=/opt/factortester-container/migration
FACTORTESTER_POSTGRES_BACKUP_DIR=/opt/factortester-container/backups
FACTORTESTER_POSTGRES_VOLUME=factortester-postgres-control
