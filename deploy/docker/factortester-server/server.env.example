# Copy this file outside the repository, restrict it to mode 0600, and pass it
# through FACTORTESTER_DOCKER_ENV_FILE. Do not place private keys in this file.

FACTORTESTER_COMPOSE_PROJECT=factortester-local-server
FACTORTESTER_UID=501
FACTORTESTER_GID=20

# The linked-worktree common repository and the Manager's stable source
# worktree must both appear at their original absolute paths in the container.
FACTORTESTER_GIT_ROOT=/Users/example/Documents/GTHT/Codes
FACTORTESTER_REPO_ROOT=/Users/example/Documents/GTHT/Codes-master-server
FACTORTESTER_SETTINGS_FILE=/Users/example/Documents/GTHT/.settings
FACTORTESTER_DATA_ROOT=/Users/example/Documents/GTHT/FactorTester
FACTORTESTER_STATE_ROOT=/Users/example/Library/Application Support/FactorTester/server-docker/staging-state

# Every *.conf file in this directory defines one server-only interface. The
# directory is mounted only in the WireGuard sidecar. Use mode 0700 for the
# directory and mode 0600 for each file.
FACTORTESTER_WIREGUARD_CONFIG_DIR=/Users/example/Library/Application Support/FactorTester/server-docker/wireguard

# Public Manager CA certificate. Verify its SHA-256 fingerprint out of band
# before storing this non-secret public certificate for a read-only mount.
FACTORTESTER_FEDERATION_CA_SOURCE=/Users/example/Library/Application Support/FactorTester/server-docker/trust/remote-manager.crt

FACTORTESTER_SERVER_ROLE=feat
FACTORTESTER_SERVER_ID=local-feat-docker-staging
FACTORTESTER_LAN_ADDRESS=192.168.1.10

# Development only: restart the Manager subprocess when mounted Python source
# changes. Keep this disabled in the public main deployment.
FACTORTESTER_HOT_RELOAD=1

# Canonical client ports are published directly by the Docker stack. Peer
# 17998/17997 listeners remain inside the WireGuard network namespace.
FACTORTESTER_BIND_ADDRESS=0.0.0.0
FACTORTESTER_MANAGER_HOST_PORT=7998
FACTORTESTER_ARTIFACT_HOST_PORT=7997

# Peers use the container's WireGuard address and never the host's public/LAN
# address for 17998/17997.
FACTORTESTER_PEER_ADDRESS=10.77.0.3
FACTORTESTER_MANAGER_PUBLIC_ENDPOINT=http://10.77.0.3:7998
FACTORTESTER_ARTIFACT_PUBLIC_ENDPOINT=http://10.77.0.3:7997

# Local/LAN policy. The public deployment uses stricter values.
FACTORTESTER_REQUIRE_LOGIN_FOR_UI=0
FACTORTESTER_ALLOW_PUBLIC_REGISTRATION=1
FACTORTESTER_REQUIRE_DEVICE_AUTH=0
FACTORTESTER_PUBLIC_SERVER=0
