{
  "name": "@traderesearch/web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/*.test.ts src/notifications/*.test.ts src/configuration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:desktop && npm run build:mobile && npm run build:loader && npm run build:configuration-code",
    "build:desktop": "esbuild src/desktop-entry.tsx --bundle --minify --format=iife --target=es2020 --outfile=../../static/vendor/web-app/desktop.js",
    "build:mobile": "esbuild src/mobile-entry.tsx --bundle --minify --format=iife --target=es2020 --outfile=../../static/vendor/web-app/mobile.js",
    "build:loader": "esbuild src/loader.ts --minify --format=iife --target=es2020 --outfile=../../static/vendor/web-app/loader.js",
    "build:configuration-code": "esbuild src/configuration/code-entry.ts --bundle --minify --format=iife --target=es2020 --loader:.ttf=dataurl --outfile=../../static/vendor/web-app/configuration-code.js && esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --minify --format=iife --outfile=../../static/vendor/web-app/configuration-editor-worker.js && esbuild node_modules/monaco-editor/esm/vs/language/json/json.worker.js --bundle --minify --format=iife --outfile=../../static/vendor/web-app/configuration-json-worker.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ionic/react": "9.0.9",
    "@ionic/react-router": "9.0.9",
    "@rjsf/antd": "6.11.0",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "antd": "^5.29.3",
    "dockview-react": "8.6.1",
    "i18next": "^25.10.10",
    "ionicons": "8.0.13",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "0.57.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
