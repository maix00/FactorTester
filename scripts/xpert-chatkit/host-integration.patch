+function FTProcessGroup({ data }: { data: any }) {
+  const [open, setOpen] = React.useState(false);
+  const [loaded, setLoaded] = React.useState<Record<string, any>>({});
+  const [error, setError] = React.useState('');
+  const [loading, setLoading] = React.useState(false);
+  const pending = React.useRef(false);
+  const items = data.items as any[];
+  const expand = async (expanded: boolean) => {
+    setOpen(expanded);
+    if (!expanded || pending.current) return;
+    const missing = items.filter(item => item.details_deferred && (!loaded[item.id]
+      || JSON.stringify(loaded[item.id].workflow?.tasks?.map((task: any) => task.status_indicator))
+        !== JSON.stringify(item.workflow?.tasks?.map((task: any) => task.status_indicator))));
+    if (!missing.length) return;
+    pending.current = true; setLoading(true); setError('');
+    try {
+      const pages = await Promise.all([...new Set(missing.map(item => item.detail_after || ''))].map(async after => {
+        const response = await fetch(`/ft-profile-bridge/conversations/${encodeURIComponent(data.conversationId)}/process-details`, {
+          method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({after}),
+        });
+        const payload = await response.json();
+        if (!response.ok) throw new Error(payload.error || '读取执行详情失败');
+        return payload.data || [];
+      }));
+      setLoaded(previous => ({...previous, ...Object.fromEntries(pages.flat().map((item: any) => [item.id, item]))}));
+    } catch (error) { setError(error instanceof Error ? error.message : String(error)); }
+    finally { pending.current = false; setLoading(false); }
+  };
+  React.useEffect(() => { if (open) void expand(true); }, [data.items]);
+  const failed = items.some(item => item.workflow?.tasks?.some((task: any) => /error|failed/.test(task.status_indicator || '')));
+  return <details className="ft-process w-full text-sm text-muted-foreground" open={open}
+    onToggle={event => { void expand(event.currentTarget.open); }}>
+    <summary className="cursor-pointer py-2">执行过程 · {items.length} 步{failed ? ' · 有失败步骤' : ''}</summary>
+    {open && <div className="ft-process-steps pl-3">
+      {loading && <p>正在加载执行详情…</p>}
+      {error && <button onClick={() => void expand(true)}>重试：{error}</button>}
+      {items.map(item => <details key={item.id} className="ft-process-step">
+        <summary className="cursor-pointer" title={(item.workflow?.tasks || []).map((task: any) => task.title).join(' · ')}><span>{(item.workflow?.tasks || []).map((task: any) => task.title).join(' · ') || '执行步骤'}</span></summary>
+        <FTProcessDetail item={item.details_deferred ? loaded[item.id] || item : item} />
+      </details>)}
+    </div>}
+  </details>;
