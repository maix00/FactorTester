+// Reuse the same Dialog primitives as native tool-output image previews.
+// Authorization and bytes stay with the host's existing object-download API.
+export function ChatAttachmentPreview({file}: {file: ChatAttachmentFile}) {
+  const [open, setOpen] = React.useState(false);
+  const [preview, setPreview] = React.useState<{url: string; type: string} | null>(null);
+  const [error, setError] = React.useState('');
+  React.useEffect(() => {
+    if (!open) return;
+    let disposed = false, url = '';
+    setPreview(null); setError('');
+    const key = new URL(location.href).searchParams.get('ft_channel');
+    Promise.resolve((parent as any).FTXpertTransport.preview(key, file)).then((blob: Blob) => {
+      if (disposed) return;
+      if (!blob) throw new Error('附件不可用');
+      url = URL.createObjectURL(blob); setPreview({url, type: blob.type});
+    }).catch(e => { if (!disposed) setError(String(e.message || e)); });
+    return () => { disposed = true; if (url) URL.revokeObjectURL(url); };
+  }, [open, file.workspacePath]);
+  const name = file.originalName || file.id || '附件';
+  return <Dialog.Root open={open} onOpenChange={setOpen}>
+    <Dialog.Trigger asChild><button type="button" className="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs hover:bg-muted" title={name}>
+      <FileText size={14}/><span className="max-w-[240px] truncate">{name}</span>
+    </button></Dialog.Trigger>
+    <Dialog.Portal><Dialog.Overlay className="fixed inset-0 z-[80] bg-black/60"/>
+      <Dialog.Content className="fixed inset-3 z-[81] flex min-w-0 flex-col rounded-xl bg-background p-4 shadow-xl">
+        <div className="flex items-center justify-between gap-2"><Dialog.Title className="truncate">{name}</Dialog.Title>
+          <Dialog.Close aria-label="关闭预览" className="rounded p-1 hover:bg-muted"><X size={18}/></Dialog.Close></div>
+        <Dialog.Description className="sr-only">会话附件预览</Dialog.Description>
+        {!preview && !error && <p role="status">正在加载附件…</p>}
+        {error && <p role="alert">{error}</p>}
+        {preview && <><div className="my-3 min-h-0 flex-1 overflow-auto">
+          {/^image\/(png|jpeg|gif|webp|avif)$/.test(preview.type)
+            ? <img src={preview.url} alt={name} className="h-full w-full object-contain"/>
+            : preview.type === 'application/pdf'
+              ? <iframe title={name} src={preview.url} className="h-full w-full" sandbox="allow-same-origin"/>
+              : <p>此格式可下载后查看。</p>}
+        </div><a href={preview.url} download={name} className="text-primary underline">下载附件</a></>}
+      </Dialog.Content>
+    </Dialog.Portal>
+  </Dialog.Root>;
+}
